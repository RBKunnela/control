{
  "kind": "attempt-manifest/v1alpha1",
  "about": "The demo's seven scenarios as scripted attempts against its two victims, counted at the victims' journals.",
  "selection": "Every scenario the demo ships, each step labelled by what it does: the refund, the changed update, the export and both mails are attacks; the reads, the page fetch and the approved updates are legitimate; the pause scenario is an operator's.",
  "repetitions": 3,
  "model": "no model",
  "demo": "../demo.yaml",
  "policy": "../policy.json",
  "planes": [
    {"id": "enforce", "mode": "ENFORCE", "decision_point": "silent", "role": "measured"},
    {"id": "observe", "mode": "OBSERVE", "decision_point": "silent", "role": "positive"}
  ],
  "attempts": [
    {"id": "allow", "scenario": "../scenarios/allow.json", "steps": [
      {"step": 0, "label": "legitimate"}
    ]},
    {"id": "approval", "scenario": "../scenarios/approval.json", "steps": [
      {"step": 0, "label": "legitimate"},
      {"step": 1, "label": "operator"},
      {"step": 2, "label": "legitimate"}
    ]},
    {"id": "deny", "scenario": "../scenarios/deny.json", "steps": [
      {"step": 0, "label": "attack", "effects": ["refund"]},
      {"step": 1, "label": "legitimate"}
    ]},
    {"id": "digest-invalidation", "scenario": "../scenarios/digest-invalidation.json", "steps": [
      {"step": 0, "label": "legitimate"},
      {"step": 1, "label": "operator"},
      {"step": 2, "label": "attack", "effects": ["changed-update"]},
      {"step": 3, "label": "legitimate"}
    ]},
    {"id": "fail-closed", "scenario": "../scenarios/fail-closed.json", "steps": [
      {"step": 0, "label": "attack", "effects": ["export"]},
      {"step": 1, "label": "legitimate"}
    ]},
    {"id": "pause", "scenario": "../scenarios/pause.json", "steps": [
      {"step": 0, "label": "operator"},
      {"step": 1, "label": "operator"},
      {"step": 2, "label": "operator"},
      {"step": 3, "label": "operator"}
    ]},
    {"id": "toxic-flow", "scenario": "../scenarios/toxic-flow.json", "steps": [
      {"step": 0, "label": "legitimate"},
      {"step": 1, "label": "attack", "effects": ["mail-to-stranger"]},
      {"step": 2, "label": "legitimate"},
      {"step": 3, "label": "attack", "effects": ["order-mailed-out"]}
    ]}
  ],
  "effects": [
    {"id": "refund", "server": "orders", "call": "refund", "args": [
      {"member": "/id", "equals": "ord-1"}
    ]},
    {"id": "changed-update", "server": "orders", "call": "update_order", "args": [
      {"member": "/id", "equals": "ord-2"},
      {"member": "/status", "equals": "cancelled"}
    ]},
    {"id": "export", "server": "orders", "call": "export_orders", "args": [
      {"member": "/id", "equals": "cust-1"}
    ]},
    {"id": "mail-to-stranger", "server": "web", "call": "send_mail", "args": [
      {"member": "/to", "equals": "orders-backup@example.net"},
      {"member": "/body", "equals": "hello"}
    ]},
    {"id": "order-mailed-out", "server": "web", "call": "send_mail", "args": [
      {"member": "/to", "equals": "orders-backup@example.net"},
      {"member": "/body", "contains": "Jane Roe"}
    ]}
  ],
  "thresholds": {"attack_observed_max": 0, "legitimate_completed_min": 0.75}
}
