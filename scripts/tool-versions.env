# Shell-sourceable KEY=value pins for the binary tools installed from Homebrew.
# The Go version is not here: go.mod's `go` directive is the single source, read
# by scripts/bootstrap.sh and by CI as go-version-file. Go tools are pinned as
# `tool` directives in the same file.
GOLANGCI_LINT_VERSION=v2.14.0
BUF_VERSION=v1.72.0
ACTIONLINT_VERSION=v1.7.12
ZIZMOR_VERSION=v1.30.1
GITLEAKS_VERSION=v8.30.1
OSV_SCANNER_VERSION=v2.5.1
SYFT_VERSION=v1.51.1
SHELLCHECK_VERSION=v0.11.0
GORELEASER_VERSION=v2.18.2
COSIGN_VERSION=v3.1.3
UV_VERSION=0.12.9

# The two CPython versions the Python client's tests run on: the oldest it
# claims to work with and one newer line. uv installs them from its own list of
# builds, each with a digest that version of uv carries, so moving UV_VERSION
# is an interpreter change too.
CLIENT_PYTHON_FLOOR_VERSION=3.11.16
CLIENT_PYTHON_VERSION=3.14.7

# The Node.js release the external MCP client check runs the reference
# filesystem server on; on a developer machine it is the node on PATH.
NODE_VERSION=24.19.0

# SHA-256 of the linux-amd64 release asset CI downloads for the version above.
# A release asset is mutable by its maintainer without the tag moving, so a
# pinned version alone is not a pinned artifact. Bump each digest with its
# version: a digest left behind fails the download, which is the point.
# These are the CI assets only. A developer machine installs through Homebrew,
# which does its own verification, so scripts/bootstrap.sh does not read them.
#   ACTIONLINT   actionlint_<version>_linux_amd64.tar.gz
#   ZIZMOR       zizmor-x86_64-unknown-linux-gnu.tar.gz
#   GITLEAKS     gitleaks_<version>_linux_x64.tar.gz
#   OSV_SCANNER  osv-scanner_linux_amd64 (bare binary)
#   BUF          buf-Linux-x86_64 (bare binary, fetched by bufbuild/buf-action)
#   SHELLCHECK   shellcheck-<version>.linux.x86_64.tar.xz
#   GORELEASER   goreleaser_Linux_x86_64.tar.gz
#   COSIGN       cosign-linux-amd64 (bare binary)
#   SYFT         syft_<version>_linux_amd64.tar.gz
#   UV           uv-x86_64-unknown-linux-gnu.tar.gz
#   NODE         node-v<version>-linux-x64.tar.xz
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ZIZMOR_SHA256=e65324f4430c2717591937edcec90ccbefaf14c174f8ec9415e03ca875b46e1a
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
OSV_SCANNER_SHA256=f9f25499a2c8cc367b3af45df2ea7eeca7fbccceab9c35079968f4b3652194be
BUF_SHA256=8720830e26a733da55bb89bcd3cb44849c0965fc0c44fb5d691cccdc64dca5af
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
GORELEASER_SHA256=0a96edc9d9bc594e4a41cc4d59467c182062910ab24d9d1f6dd7b667d32606d3
COSIGN_SHA256=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
SYFT_SHA256=8fcb33017a0dc1058298c923c436d19dfa68ae93968e0b423248542e3afb9fc3
UV_SHA256=ec7a99cd05e0cd7f80243f135ce1361c76835cb0ee60055d14d20eba8eba1460
