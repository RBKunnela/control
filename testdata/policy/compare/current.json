{
  "apiVersion": "agent-policy/v1alpha1",
  "bundle": {
    "id": "orders",
    "version": "2026-11-01.1",
    "serial": 1,
    "maxStaleSeconds": 3600
  },
  "rules": [
    {
      "id": "reads",
      "effect": "ALLOW",
      "when": {
        "action": {
          "effect": [
            "READ"
          ]
        },
        "resource": {
          "type": [
            "order"
          ]
        }
      }
    },
    {
      "id": "no-deletes",
      "effect": "DENY",
      "when": {
        "action": {
          "effect": [
            "DELETE"
          ]
        }
      }
    },
    {
      "id": "refunds-need-approval",
      "effect": "REQUIRE_APPROVAL",
      "when": {
        "action": {
          "name": [
            "refund"
          ],
          "effect": [
            "TRANSACT"
          ]
        }
      }
    },
    {
      "id": "no-confidential-out",
      "effect": "DENY",
      "when": {
        "action": {
          "name": [
            "send_mail"
          ]
        },
        "data": {
          "sensitivityAtLeast": "CONFIDENTIAL"
        },
        "destination": {
          "trustZone": [
            "UNTRUSTED_EXTERNAL"
          ]
        }
      }
    },
    {
      "id": "no-toxic-mail",
      "effect": "DENY",
      "reason": "TOXIC_FLOW_SENSITIVE_TO_EXTERNAL",
      "when": {
        "action": {
          "name": [
            "send_mail"
          ]
        },
        "flow": {
          "toxicAtLeast": "INTERNAL"
        }
      }
    },
    {
      "id": "mail",
      "effect": "ALLOW",
      "when": {
        "action": {
          "name": [
            "send_mail"
          ]
        }
      }
    },
    {
      "id": "transfers",
      "effect": "ALLOW",
      "when": {
        "action": {
          "name": [
            "transfer"
          ]
        }
      }
    },
    {
      "id": "transfers-vetoed",
      "effect": "DENY",
      "when": {
        "action": {
          "name": [
            "transfer"
          ]
        },
        "external": {
          "denies": true
        }
      }
    },
    {
      "id": "wires-in-prod",
      "effect": "REQUIRE_APPROVAL",
      "when": {
        "action": {
          "name": [
            "wire"
          ]
        },
        "resource": {
          "environment": [
            "prod"
          ]
        }
      }
    }
  ]
}
