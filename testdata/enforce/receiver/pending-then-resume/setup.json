{
  "mode": "ENFORCEMENT_MODE_APPROVE",
  "rules": [
    {
      "id": "approve-refunds",
      "effect": "REQUIRE_APPROVAL",
      "when": {
        "action": {
          "name": [
            "refund"
          ]
        }
      }
    }
  ],
  "tools": [
    {
      "name": "refund",
      "effect": "EFFECT_CLASS_TRANSACT",
      "provider": "payments",
      "resource_type": "account",
      "resource_from": "/account"
    },
    {
      "name": "read_file",
      "effect": "EFFECT_CLASS_READ",
      "provider": "files",
      "resource_type": "file",
      "resource_from": "/path"
    }
  ],
  "execution_lifetime": "60s",
  "runs": [
    {
      "name": "a",
      "token": "run-a.token-a",
      "for": "listener"
    },
    {
      "name": "b",
      "token": "run-b.token-b",
      "for": "listener"
    }
  ]
}
