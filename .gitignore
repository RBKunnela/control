# Every group below is mirrored by hand in scripts/lib/repo-files.sh, whose
# find fallback lists files in a tree with no .git, such as an export. Change
# both together.

# Build and editor noise
.DS_Store
.env
.env.*
!.env.example
bin/
dist/
/coverage/
*.out
*.test
*.pyc
.idea/
.vscode/
.venv/
.mypy_cache/
.ruff_cache/
node_modules/

# Go workspace files are per-developer
go.work
go.work.sum

# Benchmark runs: a published one (scripts/bench.sh --publish) is tracked, a
# local one lands in local/, and nothing else in the directory is. The find
# fallback in scripts/lib/repo-files.sh and internal/docscheck/impact mirror
# these lines, and a test in the latter compares all three.
/bench/results/*
!/bench/results/.keep
# With core.ignorecase=true, git's default on macOS, this also keeps a .TXT name, which both mirrors drop.
!/bench/results/[0-9]*T[0-9]*Z-*-*.txt
/bench/results/*/

# Local override of the project law, per developer
/AGENTS.local.md
